{
  "permissions": {
    "allow": [
      "Bash(python3 -m runlab:*)",
      "Bash(python3 -m unittest:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && python3 -m runlab auto --hook 2>/dev/null || true",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
