# Copy to .env (python3 -m runlab init does this). .env is gitignored: never commit it.
# Garmin Connect Personal API key: create it at
#   https://connect.garmin.com/app/settings/personalApiToken  (see docs/garmin-setup.md)
GARMIN_PERSONAL_API_KEY=

# Optional: where your private workspace lives (default: ./me)
# RUNLAB_HOME=
